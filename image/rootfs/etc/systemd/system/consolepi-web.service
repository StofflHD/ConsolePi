[Unit]
Description=ConsolePi web terminal (ttyd, https port 443)
Documentation=https://github.com/StofflHD/ConsolePi/tree/master/image
After=network.target consolepi-setup.service

[Service]
# self-signed certificate, generated on first start (unique per Pi)
ExecStartPre=/usr/local/sbin/consolepi-web-cert
# ttyd options (font size, colours) are in the script; login with the normal Pi user, then
# consolepi-menu starts (see /etc/profile.d/zz-consolepi-web.sh)
ExecStart=/usr/local/sbin/consolepi-web-start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
