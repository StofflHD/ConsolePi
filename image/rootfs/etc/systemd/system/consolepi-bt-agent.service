[Unit]
Description=ConsolePi Bluetooth pairing agent (Bluetooth serial console)
ConditionPathIsDirectory=/sys/class/bluetooth
Requires=bluetooth.service
After=bluetooth.service consolepi-setup.service
PartOf=bluetooth.service

[Service]
ExecStart=/usr/local/sbin/consolepi-bt-agent
Restart=on-failure
RestartSec=5

[Install]
WantedBy=bluetooth.target
