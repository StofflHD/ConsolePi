#!/usr/bin/python3
"""Bluetooth pairing agent for ConsolePi.

Without an agent BlueZ refuses every pairing request, so the Bluetooth serial console (rfcomm.service)
can't be reached.  This agent registers as the default agent, accepts pairing, marks paired devices
as trusted and keeps the adapter discoverable + pairable without a timeout.

PIN: /etc/consolepi-bt.conf, line `pin=<4-16 digits>` (set via bluetooth_pin= in consolepi-setup.txt).
  * with a PIN: Secure Simple Pairing is switched off so the remote device asks for the PIN
    (classic PIN pairing); requests without PIN are rejected.
  * without a PIN: "just works" pairing, anyone in range can pair.
  When the PIN (or no-PIN mode) changes, all paired devices are removed and must pair again.

Turn Bluetooth access off:  sudo systemctl disable --now consolepi-bt-agent rfcomm
"""
import hashlib
import re
import subprocess
import sys
import time
from pathlib import Path

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib

BUS_NAME = "org.bluez"
AGENT_PATH = "/consolepi/bt_agent"
CAPABILITY = "NoInputNoOutput"
CONF = Path("/etc/consolepi-bt.conf")
STATE = Path("/var/lib/consolepi-bt/pairing-mode")
OPEN_LEGACY_PIN = "0000"   # no PIN configured: answer for very old devices without Secure Simple Pairing


def log(msg):
    print(msg, flush=True)


def read_pin():
    try:
        text = CONF.read_text()
    except FileNotFoundError:
        return None
    m = re.search(r"(?m)^\s*pin\s*=\s*(\S*)\s*$", text)
    pin = m.group(1) if m else ""
    if pin and not re.fullmatch(r"\d{4,16}", pin):
        log(f"{CONF}: pin must be 4-16 digits - ignoring it, pairing WITHOUT PIN")
        return None
    return pin or None


class Rejected(dbus.DBusException):
    _dbus_error_name = "org.bluez.Error.Rejected"


class Agent(dbus.service.Object):
    def __init__(self, bus, pin):
        super().__init__(bus, AGENT_PATH)
        self.bus = bus
        self.pin = pin

    def _props(self, path):
        return dbus.Interface(self.bus.get_object(BUS_NAME, path), "org.freedesktop.DBus.Properties")

    def _get(self, device, name):
        return self._props(device).Get("org.bluez.Device1", name)

    def describe(self, device):
        try:
            return f'{self._get(device, "Alias")} ({self._get(device, "Address")})'
        except dbus.DBusException:
            return str(device)

    def trust(self, device):
        try:
            if not self._get(device, "Trusted"):
                self._props(device).Set("org.bluez.Device1", "Trusted", dbus.Boolean(True))
                log(f"trusted {self.describe(device)}")
        except dbus.DBusException as e:
            log(f"could not trust {device}: {e}")

    def _no_pin_request(self, device, what):
        if self.pin:
            log(f"rejected {what} from {self.describe(device)}: PIN required")
            raise Rejected("PIN required")
        log(f"{what} accepted: {self.describe(device)}")

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Release(self):
        log("agent released by bluetoothd")

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="")
    def RequestAuthorization(self, device):
        self._no_pin_request(device, "pairing")

    @dbus.service.method("org.bluez.Agent1", in_signature="ou", out_signature="")
    def RequestConfirmation(self, device, passkey):
        self._no_pin_request(device, "pairing")
        self.trust(device)

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def AuthorizeService(self, device, uuid):
        if self.pin and not self._get(device, "Paired"):
            log(f"rejected service {uuid} for unpaired {self.describe(device)}")
            raise Rejected("not paired")
        log(f"service {uuid} authorized for {self.describe(device)}")
        self.trust(device)

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="s")
    def RequestPinCode(self, device):
        log(f"PIN pairing: {self.describe(device)}")
        return self.pin or OPEN_LEGACY_PIN

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="u")
    def RequestPasskey(self, device):
        if self.pin:
            log(f"rejected passkey pairing from {self.describe(device)}: PIN required")
            raise Rejected("PIN required")
        return dbus.UInt32(0)

    @dbus.service.method("org.bluez.Agent1", in_signature="ouq", out_signature="")
    def DisplayPasskey(self, device, passkey, entered):
        pass

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def DisplayPinCode(self, device, pincode):
        pass

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Cancel(self):
        log("pairing cancelled by the remote device")


def find_adapter(bus, timeout=30):
    """Path of the first Bluetooth adapter; hci0 may appear a few seconds after bluetoothd."""
    om = dbus.Interface(bus.get_object(BUS_NAME, "/"), "org.freedesktop.DBus.ObjectManager")
    deadline = time.monotonic() + timeout
    while True:
        for path, ifaces in om.GetManagedObjects().items():
            if "org.bluez.Adapter1" in ifaces:
                return path
        if time.monotonic() > deadline:
            return None
        time.sleep(1)


def set_ssp(adapter, enabled):
    """Classic PIN pairing only happens with Secure Simple Pairing off.  The controller can't turn SSP
    off while powered, so power-cycle it (bluetoothd keeps its SDP records, incl. the serial port)."""
    idx = re.sub(r"\D", "", adapter.rsplit("/", 1)[-1]) or "0"
    btmgmt = ["btmgmt", "--index", idx]
    info = subprocess.run(btmgmt + ["info"], capture_output=True, text=True).stdout
    current = re.search(r"current settings:(.*)", info)
    if current and ((" ssp" in f" {current.group(1)} ") == enabled):
        return
    for args in (["power", "off"], ["ssp", "on" if enabled else "off"], ["power", "on"]):
        r = subprocess.run(btmgmt + args, capture_output=True, text=True)
        if r.returncode:
            log(f"btmgmt {' '.join(args)} failed: {(r.stderr or r.stdout).strip()}")
    log(f"Secure Simple Pairing {'on' if enabled else 'off (PIN pairing)'}")


def forget_devices_on_mode_change(bus, adapter, pin):
    """Devices paired with another PIN (or without one) have to pair again."""
    mode = "pin:" + hashlib.sha256(pin.encode()).hexdigest() if pin else "open"
    old = STATE.read_text().strip() if STATE.exists() else "open"
    if old != mode:
        om = dbus.Interface(bus.get_object(BUS_NAME, "/"), "org.freedesktop.DBus.ObjectManager")
        ad = dbus.Interface(bus.get_object(BUS_NAME, adapter), "org.bluez.Adapter1")
        removed = 0
        for path, ifaces in om.GetManagedObjects().items():
            dev = ifaces.get("org.bluez.Device1")
            if dev and dev.get("Adapter") == adapter and dev.get("Paired"):
                ad.RemoveDevice(path)
                removed += 1
        log(f"pairing mode changed: removed {removed} paired device(s), they have to pair again")
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(mode + "\n")
    STATE.chmod(0o600)


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()

    adapter = find_adapter(bus)
    if not adapter:
        log("no Bluetooth adapter found")
        sys.exit(1)

    pin = read_pin()
    set_ssp(adapter, enabled=not pin)
    forget_devices_on_mode_change(bus, adapter, pin)

    agent = Agent(bus, pin)
    manager = dbus.Interface(bus.get_object(BUS_NAME, "/org/bluez"), "org.bluez.AgentManager1")
    manager.RegisterAgent(AGENT_PATH, CAPABILITY)
    manager.RequestDefaultAgent(AGENT_PATH)

    props = dbus.Interface(bus.get_object(BUS_NAME, adapter), "org.freedesktop.DBus.Properties")
    for name, value in (("Powered", dbus.Boolean(True)),
                        ("PairableTimeout", dbus.UInt32(0)), ("Pairable", dbus.Boolean(True)),
                        ("DiscoverableTimeout", dbus.UInt32(0)), ("Discoverable", dbus.Boolean(True))):
        try:
            props.Set("org.bluez.Adapter1", name, value)
        except dbus.DBusException as e:
            log(f"could not set {name}: {e}")
    alias = props.Get("org.bluez.Adapter1", "Alias")
    log(f'agent ready: "{alias}" on {adapter} is discoverable, pairing '
        + ("with PIN" if pin else "WITHOUT PIN (set bluetooth_pin in consolepi-setup.txt)"))

    # trust devices as soon as they are paired (rfcomm connects need a trusted or authorized device)
    def on_props_changed(iface, changed, invalidated, path=None):
        if iface == "org.bluez.Device1" and changed.get("Paired"):
            agent.trust(path)

    bus.add_signal_receiver(on_props_changed, dbus_interface="org.freedesktop.DBus.Properties",
                            signal_name="PropertiesChanged", path_keyword="path")

    loop = GLib.MainLoop()

    # bluetoothd restarted -> registration is gone; exit so systemd starts us again
    def on_owner(owner):
        if not owner:
            log("bluetoothd went away")
            loop.quit()

    bus.watch_name_owner(BUS_NAME, on_owner)
    loop.run()
    sys.exit(1)


if __name__ == "__main__":
    main()
