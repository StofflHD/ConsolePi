#!/bin/bash
# ConsolePi: back from the hotspot to a known WiFi (run every minute by consolepi-wifi-return.timer).
#
# NetworkManager falls back to the hotspot when the WiFi is lost (or one handshake fails and it takes
# that for a wrong password), but it never leaves an active connection by itself - the Pi would stay
# on the hotspot until reboot.  This switches back when
#   - the WiFi device runs the hotspot (a connection in mode "ap"),
#   - the hotspot has been up for 2 minutes (the WiFi has just failed: leave a window to join the
#     hotspot instead of tearing it down right away),
#   - no device is connected to the hotspot (nobody gets cut off mid-session), and
#   - a known WiFi (saved, autoconnect on) is in range.
# After a failed attempt it waits 10 minutes before trying again.
#
#   consolepi-wifi-return                                  check once (needs root)
#   CONSOLEPI_WIFI_RETURN_DRYRUN=1 consolepi-wifi-return   only print what it would do
set -u

FAILED="${CONSOLEPI_WIFI_RETURN_STATE:-/run/consolepi-wifi-return.failed}"
RETRY_AFTER=600
SINCE="${CONSOLEPI_WIFI_RETURN_SINCE:-/run/consolepi-wifi-return.hotspot}"   # "<activation> <first seen>"
HOTSPOT_MIN="${CONSOLEPI_WIFI_RETURN_HOTSPOT_MIN:-120}"
DRY="${CONSOLEPI_WIFI_RETURN_DRYRUN:-}"

mode_of() { nmcli -g 802-11-wireless.mode connection show "$1" 2>/dev/null; }

dev=$(nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2=="wifi"{print $1; exit}')
[ -n "$dev" ] || exit 0

# active connection on the WiFi device (UUIDs: names may contain anything)
read -r hotspot apath < <(nmcli -t -f UUID,DEVICE,ACTIVE-PATH connection show --active 2>/dev/null |
                          awk -F: -v d="$dev" '$2==d{print $1, $3; exit}')
[ -n "${hotspot:-}" ] || exit 0      # nothing active: NetworkManager is (re)connecting by itself
[ "$(mode_of "$hotspot")" = "ap" ] || exit 0

# how long has this hotspot activation been up?  (every activation gets a new D-Bus path)
now=$(date +%s)
read -r seen_path seen_at < "$SINCE" 2>/dev/null || true
if [ "${seen_path:-}" != "${apath:-}" ] || [ -z "${seen_at:-}" ]; then
    echo "${apath:-} $now" > "$SINCE"
    seen_at=$now
fi
[ $(( now - seen_at )) -lt "$HOTSPOT_MIN" ] && exit 0

clients=$(iw dev "$dev" station dump 2>/dev/null | grep -c '^Station')
[ "${clients:-0}" -gt 0 ] && exit 0  # someone uses the hotspot: stay

if [ -f "$FAILED" ] && [ $(( $(date +%s) - $(stat -c %Y "$FAILED") )) -lt $RETRY_AFTER ]; then
    exit 0
fi

# known WiFi profiles with autoconnect on, highest autoconnect priority first
known=$(nmcli -t -f UUID,TYPE,AUTOCONNECT,AUTOCONNECT-PRIORITY connection show 2>/dev/null |
        awk -F: '$2=="802-11-wireless" && $3=="yes" {print $4, $1}' | sort -k1,1nr | awk '{print $2}')
[ -n "$known" ] || exit 0

# scan while the hotspot runs ("ap-force"; the WiFi chip stays on the hotspot channel meanwhile)
if scan=$(iw dev "$dev" scan ap-force 2>/dev/null); then
    visible=$(printf '%s\n' "$scan" | sed -n 's/^[[:space:]]*SSID: //p')
    [ -n "$visible" ] || exit 0
    blind=
else
    # the WiFi chip can't scan while it runs the hotspot: just try the best known WiFi
    # (at most every RETRY_AFTER seconds, see the failure handling below)
    visible=
    blind=1
fi

for uuid in $known; do
    [ "$(mode_of "$uuid")" = "ap" ] && continue
    ssid=$(nmcli -g 802-11-wireless.ssid connection show "$uuid" 2>/dev/null)
    [ -n "$ssid" ] || continue
    if [ -n "$blind" ]; then
        echo "hotspot unused, can't scan -> trying WiFi '$ssid'"
    else
        printf '%s\n' "$visible" | grep -qxF -- "$ssid" || continue
        echo "hotspot unused and WiFi '$ssid' in range -> switching back"
    fi
    [ -n "$DRY" ] && exit 0
    if nmcli --wait 60 connection up "$uuid" >/dev/null 2>&1; then
        rm -f "$FAILED"
        echo "connected to '$ssid'"
    else
        touch "$FAILED"
        echo "could not connect to '$ssid' - back to the hotspot, next try in $((RETRY_AFTER / 60)) minutes"
        # NetworkManager normally brings the hotspot back by itself (autoconnect); make sure of it
        sleep 20
        nmcli -t -f DEVICE connection show --active 2>/dev/null | grep -qx "$dev" ||
            nmcli connection up "$hotspot" >/dev/null 2>&1
    fi
    exit 0
done
exit 0
