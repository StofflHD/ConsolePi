#!/usr/bin/python3
"""ConsolePi hotspot portal.

Phones, tablets and laptops check for a captive portal ("sign in to network") right after joining a
WiFi.  On the ConsolePi hotspot those check hosts resolve to the Pi (dnsmasq config for NetworkManager's
shared mode, written below), and this small web server on port 80 answers them with a page that links
to the web terminal - so the page opens by itself when you join the hotspot.

Requests for the Pi itself (http://consolepi.local, http://10.110.0.1, ...) are redirected to the
web terminal (https).  Other DNS names are not touched, so a shared uplink keeps working.

    consolepi-portal                     run the server (root: binds port 80, then drops to nobody)
    consolepi-portal --write-dns-config  only (re)write the dnsmasq config
"""
import os
import pwd
import re
import socket
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

PORT = int(os.environ.get("CONSOLEPI_PORTAL_PORT", "80"))
YAML = Path("/etc/ConsolePi/ConsolePi.yaml")
DNS_CONF = Path(os.environ.get("CONSOLEPI_PORTAL_DNS_CONF",
                               "/etc/NetworkManager/dnsmasq-shared.d/consolepi-portal.conf"))

# connectivity check hosts of iOS/macOS, Android, Windows, Firefox and Linux (NetworkManager).
# Never add a domain on the browsers' HSTS preload list (e.g. ping.archlinux.org, nmcheck.gnome.org):
# browsers then force https, hit the web terminal's certificate and refuse to show the page at all.
# Linux desktops get the page through Firefox's own check (detectportal.firefox.com) instead.
PROBE_HOSTS = [
    "captive.apple.com", "www.appleiphonecell.com", "www.itools.info", "www.ibook.info",
    "www.airport.us", "www.thinkdifferent.us",
    "connectivitycheck.gstatic.com", "connectivitycheck.android.com", "clients1.google.com",
    "clients3.google.com", "connectivitycheck.samsung.com",
    "www.msftconnecttest.com", "ipv6.msftconnecttest.com", "www.msftncsi.com",
    "detectportal.firefox.com",
    "network-test.debian.org", "connectivity-check.ubuntu.com",
]

PAGE = """<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ConsolePi</title>
<style>
:root {{ --bg: #26221f; --fg: #f2ede8; --muted: #b8aea5; --accent: #f0773a; --panel: #312c28; }}
body {{ margin: 0; background: var(--bg); color: var(--fg);
       font: 17px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }}
main {{ max-width: 34rem; margin: 0 auto; padding: 32px 16px; }}
h1 {{ margin: 0 0 4px; font-size: 1.7rem; }} h1 span {{ color: var(--accent); }}
p {{ margin: 0 0 16px; }} .muted {{ color: var(--muted); font-size: .95rem; }}
a.btn {{ display: block; margin: 24px 0; padding: 14px 16px; border-radius: 12px; text-align: center;
        background: var(--accent); color: #26221f; font-weight: 600; text-decoration: none; font-size: 1.1rem; }}
.box {{ background: var(--panel); border-radius: 12px; padding: 14px 16px; }}
code {{ color: var(--accent); }}
</style></head>
<body><main>
<h1>Console<span>Pi</span></h1>
<p class="muted">{name} &middot; hotspot</p>
<a class="btn" href="{url}">Open web terminal</a>
<div class="box">
<p>The browser warns about the certificate once (self-signed, made on this Pi):
<b>Advanced &rarr; Proceed</b> / <b>Show details &rarr; visit this website</b>.</p>
<p class="muted">If the button does nothing in this sign-in window: close it, choose
<b>Use without internet</b> / <b>Stay connected</b>, then open <code>{url}</code> in your browser.
SSH: <code>ssh &lt;user&gt;@{ip}</code></p>
</div>
</main></body></html>
"""


def wlan_ip() -> str:
    try:
        m = re.search(r"(?m)^\s*wlan_ip:\s*['\"]?(\d+\.\d+\.\d+\.\d+)", YAML.read_text())
        if m:
            return m.group(1)
    except OSError:
        pass
    return "10.110.0.1"


def write_dns_config() -> None:
    """Takes effect the next time the hotspot starts (NetworkManager starts dnsmasq per activation)."""
    ip = wlan_ip()
    text = ("# written by consolepi-portal: phones' captive portal checks -> ConsolePi portal page\n"
            + "".join(f"address=/{h}/{ip}\n" for h in PROBE_HOSTS))
    if not DNS_CONF.exists() or DNS_CONF.read_text() != text:
        DNS_CONF.parent.mkdir(parents=True, exist_ok=True)
        DNS_CONF.write_text(text)
        print(f"wrote {DNS_CONF} (hotspot ip {ip})", flush=True)


class Handler(BaseHTTPRequestHandler):
    server_version = "ConsolePi"
    sys_version = ""

    def _reply(self, head_only: bool) -> None:
        host = (self.headers.get("Host") or "").strip().lower()
        host = host.rsplit(":", 1)[0] if host.count(":") == 1 else host   # drop :port (not IPv6)
        local_ip = self.connection.getsockname()[0]
        name = socket.gethostname().lower()
        if host in {name, f"{name}.local", local_ip, wlan_ip()}:
            self.send_response(302)
            self.send_header("Location", f"https://{host}/")
            self.send_header("Content-Length", "0")
            self.end_headers()
            return
        body = PAGE.format(name=name, ip=local_ip, url=f"https://{local_ip}/").encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if not head_only:
            self.wfile.write(body)

    def do_GET(self):
        self._reply(head_only=False)

    def do_POST(self):
        self._reply(head_only=False)

    def do_HEAD(self):
        self._reply(head_only=True)

    def log_message(self, fmt, *args):
        pass


def drop_privileges() -> None:
    if os.getuid() != 0:
        return
    nobody = pwd.getpwnam("nobody")
    os.setgroups([])
    os.setgid(nobody.pw_gid)
    os.setuid(nobody.pw_uid)


def main() -> int:
    if os.getuid() == 0:
        try:
            write_dns_config()
        except OSError as e:
            print(f"could not write {DNS_CONF}: {e}", flush=True)
    if "--write-dns-config" in sys.argv:
        return 0
    server = ThreadingHTTPServer(("", PORT), Handler)
    drop_privileges()
    print(f"portal listening on port {PORT}", flush=True)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
